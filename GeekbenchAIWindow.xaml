<Window x:Class="SpecIQ.GeekbenchAIWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpecIQ — Geekbench AI"
        WindowStyle="None"
        Background="#1A1A2E"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="True"
        MouseLeftButtonDown="TitleBar_MouseDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>


    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#70FFFFFF"/>
        </Style>
        <Style x:Key="BigVal" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="28"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="SmallVal" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Border Background="#EE1A1A2E" CornerRadius="14" Width="400" x:Name="RootBorder">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>

        <StackPanel>

            <!-- Title bar -->
            <Grid Margin="20,16,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="GEEKBENCH" FontSize="11" FontWeight="Bold" Foreground="#A78BFA"/>
                    <TextBlock Text=" AI"       FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource CloseBtn}" Click="Close_Click"/>
            </Grid>

            <Border Height="1" Background="#15FFFFFF" Margin="0,12,0,0"/>

            <!-- CONFIG PANEL -->
            <StackPanel x:Name="ConfigPanel" Margin="20,16,20,20">

                <TextBlock Text="On-device AI performance benchmark."
                           Foreground="#70FFFFFF" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <!-- Install status -->
                <Border Background="#0FFFFFFF" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="GEEKBENCH AI" Style="{StaticResource Label}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="StatusText" Text="Checking…"
                                       FontSize="11" Foreground="#CCFFFFFF"/>
                        </StackPanel>
                        <Button x:Name="InstallBtn" Grid.Column="1"
                                Content="Download" Visibility="Collapsed"
                                Background="#7C3AED" Style="{StaticResource Btn}"
                                Padding="14,7"
                                Click="Install_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Previous result (shown after first benchmark) -->
                <Border x:Name="PreviousBorder" Visibility="Collapsed"
                        Background="#0FFFFFFF" CornerRadius="6"
                        Padding="12,8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="PrevHeaderText"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="#60FFFFFF" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="FULL" FontSize="9" FontWeight="SemiBold"
                                           Foreground="#70FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock x:Name="PrevFP32" Text="—" FontSize="14"
                                           FontWeight="SemiBold" Foreground="#A78BFA" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="HALF" FontSize="9" FontWeight="SemiBold"
                                           Foreground="#70FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock x:Name="PrevFP16" Text="—" FontSize="14"
                                           FontWeight="SemiBold" Foreground="#818CF8" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="QUANT" FontSize="9" FontWeight="SemiBold"
                                           Foreground="#70FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock x:Name="PrevQuant" Text="—" FontSize="14"
                                           FontWeight="SemiBold" Foreground="#34D399" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- QNN row (Snapdragon only) -->
                <Grid x:Name="QnnRow" Visibility="Collapsed" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RunQnnBtn" Grid.Column="0"
                            Content="QNN  (NPU)" Background="#059669"
                            Style="{StaticResource Btn}" Click="RunQnnSingle_Click" IsEnabled="False"/>
                    <Button x:Name="RunQnnTrialsBtn" Grid.Column="2"
                            Content="QNN  ×3 Trials" Background="#047857"
                            Style="{StaticResource Btn}" Click="RunQnnTrials_Click" IsEnabled="False"/>
                </Grid>

                <!-- CPU row -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RunCpuBtn" Grid.Column="0"
                            Content="CPU" Background="#7C3AED"
                            Style="{StaticResource Btn}" Click="RunCpuSingle_Click" IsEnabled="False"/>
                    <Button x:Name="RunCpuTrialsBtn" Grid.Column="2"
                            Content="CPU  ×3 Trials" Background="#6D28D9"
                            Style="{StaticResource Btn}" Click="RunCpuTrials_Click" IsEnabled="False"/>
                </Grid>

                <!-- GPU row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RunGpuBtn" Grid.Column="0"
                            Content="GPU  (OpenCL)" Background="#5B21B6"
                            Style="{StaticResource Btn}" Click="RunGpuSingle_Click" IsEnabled="False"/>
                    <Button x:Name="RunGpuTrialsBtn" Grid.Column="2"
                            Content="GPU  ×3 Trials" Background="#4C1D95"
                            Style="{StaticResource Btn}" Click="RunGpuTrials_Click" IsEnabled="False"/>
                </Grid>

            </StackPanel>

            <!-- RUNNING PANEL -->
            <StackPanel x:Name="RunningPanel" Visibility="Collapsed" Margin="20,16,20,20">

                <TextBlock x:Name="RunSubtitleText" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                <TextBlock x:Name="RunTrialText" FontSize="9" Foreground="#60FFFFFF"
                           Margin="0,0,0,10" Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock x:Name="RunPhaseText" FontSize="13" FontWeight="SemiBold"
                               Foreground="#A78BFA"/>
                    <TextBlock x:Name="Dot1" Text=" ●" FontSize="8" Foreground="#A78BFA"
                               VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                    <TextBlock x:Name="Dot2" Text="●" FontSize="8" Foreground="#A78BFA"
                               VerticalAlignment="Bottom" Margin="2,0,0,2" Opacity="0.5"/>
                    <TextBlock x:Name="Dot3" Text="●" FontSize="8" Foreground="#A78BFA"
                               VerticalAlignment="Bottom" Margin="2,0,0,2" Opacity="0.25"/>
                </StackPanel>

                <ScrollViewer x:Name="LogScroll" MaxHeight="140" Margin="0,8,0,12"
                              VerticalScrollBarVisibility="Auto" Background="#08FFFFFF">
                    <TextBlock x:Name="LogText" FontSize="9" Foreground="#70FFFFFF"
                               FontFamily="Consolas" TextWrapping="Wrap" Padding="8"/>
                </ScrollViewer>

                <!-- Cancel with inline confirmation -->
                <StackPanel x:Name="CancelArea" HorizontalAlignment="Center">
                    <Button x:Name="CancelBtn" Content="Cancel" Background="#DC2626"
                            Style="{StaticResource Btn}" Click="Cancel_Click"/>
                    <StackPanel x:Name="CancelConfirmPanel" Visibility="Collapsed"
                                Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <TextBlock Text="Cancel run?" Foreground="#80FFFFFF" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Yes" Click="CancelConfirm_Click"
                                Background="#DC2626" Style="{StaticResource Btn}"
                                Padding="14,7" Margin="0,0,6,0"/>
                        <Button Content="Keep running" Click="CancelDismiss_Click"
                                Background="#30FFFFFF" Style="{StaticResource Btn}"
                                Padding="14,7"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- SINGLE RESULTS PANEL -->
            <StackPanel x:Name="ResultsPanel" Visibility="Collapsed" Margin="20,16,20,20">

                <TextBlock x:Name="ResBackendText" FontSize="12" FontWeight="SemiBold"
                           Foreground="White" Margin="0,0,0,2"/>
                <TextBlock x:Name="ResMachineText" FontSize="10" Foreground="#60FFFFFF"
                           Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#140F172A" CornerRadius="8"
                            BorderBrush="#20A78BFA" BorderThickness="1" Padding="10,10">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="FULL"      Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,0,0,1"/>
                            <TextBlock Text="PRECISION" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock x:Name="ResFP32" Text="—" Style="{StaticResource BigVal}"
                                       Foreground="#A78BFA" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#140F172A" CornerRadius="8"
                            BorderBrush="#20818CF8" BorderThickness="1" Padding="10,10">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="HALF"      Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,0,0,1"/>
                            <TextBlock Text="PRECISION" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock x:Name="ResFP16" Text="—" Style="{StaticResource BigVal}"
                                       Foreground="#818CF8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="#140F172A" CornerRadius="8"
                            BorderBrush="#2034D399" BorderThickness="1" Padding="10,10">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="QUAN-"  Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,0,0,1"/>
                            <TextBlock Text="TIZED"  Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock x:Name="ResQuant" Text="—" Style="{StaticResource BigVal}"
                                       Foreground="#34D399" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="ExportBtn" Content="Copy"
                            Background="#1E293B" Style="{StaticResource Btn}" Click="Export_Click"/>
                    <Button Grid.Column="2" Content="Run Again"
                            Background="#7C3AED" Style="{StaticResource Btn}" Click="RunAgain_Click"/>
                </Grid>

            </StackPanel>

            <!-- TRIALS RESULTS PANEL -->
            <StackPanel x:Name="TrialResultsPanel" Visibility="Collapsed" Margin="20,16,20,20">

                <TextBlock x:Name="TrialResBackendText" FontSize="12" FontWeight="SemiBold"
                           Foreground="White" Margin="0,0,0,2"/>
                <TextBlock x:Name="TrialResMachineText" FontSize="10" Foreground="#60FFFFFF"
                           Margin="0,0,0,12"/>

                <!-- Score table: label | T1 | T2 | T3 -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Trial 1" Style="{StaticResource Label}"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Trial 2" Style="{StaticResource Label}"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Trial 3" Style="{StaticResource Label}"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>

                    <!-- Full Precision row -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Full" Style="{StaticResource Label}"
                               Foreground="#A78BFA" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TFP32_1" Grid.Row="1" Grid.Column="1" Text="—"
                               Style="{StaticResource SmallVal}" Foreground="#A78BFA" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TFP32_2" Grid.Row="1" Grid.Column="2" Text="—"
                               Style="{StaticResource SmallVal}" Foreground="#A78BFA" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TFP32_3" Grid.Row="1" Grid.Column="3" Text="—"
                               Style="{StaticResource SmallVal}" Foreground="#A78BFA" HorizontalAlignment="Center"/>

                    <!-- Half Precision row -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Half" Style="{StaticResource Label}"
                               Foreground="#818CF8" VerticalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TFP16_1" Grid.Row="2" Grid.Column="1" Text="—"
                               Style="{StaticResource SmallVal}" Foreground="#818CF8"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TFP16_2" Grid.Row="2" Grid.Column="2" Text="—"
                               Style="{StaticResource SmallVal}" Foreground="#818CF8"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TFP16_3" Grid.Row="2" Grid.Column="3" Text="—"
                               Style="{StaticResource SmallVal}" Foreground="#818CF8"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>

                    <!-- Quantized row -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Quantized" Style="{StaticResource Label}"
                               Foreground="#34D399" VerticalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TQuant_1" Grid.Row="3" Grid.Column="1" Text="—"
                               Style="{StaticResource SmallVal}" Foreground="#34D399"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TQuant_2" Grid.Row="3" Grid.Column="2" Text="—"
                               Style="{StaticResource SmallVal}" Foreground="#34D399"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TQuant_3" Grid.Row="3" Grid.Column="3" Text="—"
                               Style="{StaticResource SmallVal}" Foreground="#34D399"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </Grid>

                <!-- Average cards -->
                <Grid Margin="0,12,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#14A78BFA" CornerRadius="8" Padding="8,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="AVG FULL"  Style="{StaticResource Label}"
                                       HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TAvgFP32" Text="—"
                                       FontSize="20" FontWeight="Light" Foreground="#A78BFA"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#14818CF8" CornerRadius="8" Padding="8,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="AVG HALF"  Style="{StaticResource Label}"
                                       HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TAvgFP16" Text="—"
                                       FontSize="20" FontWeight="Light" Foreground="#818CF8"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="#1434D399" CornerRadius="8" Padding="8,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="AVG QUANT" Style="{StaticResource Label}"
                                       HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TAvgQuant" Text="—"
                                       FontSize="20" FontWeight="Light" Foreground="#34D399"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="TrialExportBtn" Content="Copy"
                            Background="#1E293B" Style="{StaticResource Btn}" Click="TrialExport_Click"/>
                    <Button Grid.Column="2" Content="Run Again"
                            Background="#7C3AED" Style="{StaticResource Btn}" Click="RunAgain_Click"/>
                </Grid>

            </StackPanel>

        </StackPanel>
    </Border>
</Window>
