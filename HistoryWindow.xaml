<Window x:Class="SpecIQ.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpecIQ — History"
        WindowStyle="None"
        Background="#1A1A2E"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Width="420"
        SizeToContent="Height"
        Topmost="True"
        ShowInTaskbar="True"
        MouseLeftButtonDown="TitleBar_MouseDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>


    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Foreground" Value="#70FFFFFF"/>
        </Style>
    </Window.Resources>

    <Border Background="#EE1A1A2E" CornerRadius="14" Width="420">

        <StackPanel>

            <!-- Title bar -->
            <Grid Margin="20,16,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="BENCHMARK HISTORY"
                           FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                           Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource CloseBtn}" Click="Close_Click"/>
            </Grid>

            <Border Height="1" Background="#15FFFFFF" Margin="0,12,0,0"/>

            <!-- Empty state -->
            <TextBlock x:Name="EmptyText"
                       Text="No benchmark runs recorded yet."
                       FontFamily="Segoe UI" FontSize="12" Foreground="#50FFFFFF"
                       HorizontalAlignment="Center" Margin="20,28,20,28"
                       Visibility="Collapsed"/>

            <!-- Entry list -->
            <ScrollViewer x:Name="ListScroll" MaxHeight="480"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="EntriesPanel" Margin="12,12,12,4"/>
            </ScrollViewer>

            <!-- Footer -->
            <Border Height="1" Background="#15FFFFFF" Margin="0,8,0,0"/>
            <StackPanel HorizontalAlignment="Center" Margin="0,10,0,14">
                <Button x:Name="ClearBtn" Content="Clear History" Click="Clear_Click"
                        Background="#30FFFFFF" Style="{StaticResource Btn}"
                        Padding="14,7" FontSize="11"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
