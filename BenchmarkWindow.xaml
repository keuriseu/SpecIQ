<Window x:Class="SpecIQ.BenchmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpecIQ — Benchmarks"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="True"
        MouseLeftButtonDown="TitleBar_MouseDown">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="Foreground"  Value="#70FFFFFF"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="White"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"     Value="16,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#EE1A1A2E" CornerRadius="14" Width="360">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" Opacity="0.5" ShadowDepth="4"/>
        </Border.Effect>

        <StackPanel>

            <!-- Title bar -->
            <Grid Margin="20,16,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleVersionText" Grid.Column="0" Text="GEEKBENCH"
                           FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                           Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" Click="Close_Click"
                        Background="Transparent" Foreground="#60FFFFFF"
                        FontSize="14" Padding="8,4" Cursor="Hand" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#20FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Border Height="1" Background="#15FFFFFF" Margin="0,12,0,0"/>

            <!-- ── Checking panel ── -->
            <StackPanel x:Name="CheckingPanel" Margin="20,20,20,20" HorizontalAlignment="Center">
                <TextBlock Text="Checking…" Style="{StaticResource Label}"
                           HorizontalAlignment="Center" FontSize="12"/>
            </StackPanel>

            <!-- ── Ready panel ── -->
            <StackPanel x:Name="ReadyPanel" Visibility="Collapsed" Margin="20,16,20,20">
                <TextBlock x:Name="StatusText" Text="—" Style="{StaticResource Label}"
                           HorizontalAlignment="Center" FontSize="11" Margin="0,0,0,16"/>

                <StackPanel x:Name="InstallRow" Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button x:Name="InstallBtn" Content="Install" Click="Install_Click"
                            Background="#3B82F6" Style="{StaticResource Btn}"/>
                </StackPanel>

                <StackPanel x:Name="RunRow" Visibility="Collapsed">
                    <!-- Update button -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Button x:Name="UpdateBtn" Content="Update" Click="Install_Click"
                                Background="#30FFFFFF" Style="{StaticResource Btn}"
                                Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- CPU row: Single | 3 Trials -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="CPU" Click="RunCpuSingle_Click"
                                Background="#3B82F6" Style="{StaticResource Btn}"/>
                        <Button Grid.Column="2" Content="CPU  ×3 Trials" Click="RunCpuTrials_Click"
                                Background="#2563EB" Style="{StaticResource Btn}"/>
                    </Grid>

                    <!-- GPU row: Single | 3 Trials -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="GPU" Click="RunGpuSingle_Click"
                                Background="#8B5CF6" Style="{StaticResource Btn}"/>
                        <Button Grid.Column="2" Content="GPU  ×3 Trials" Click="RunGpuTrials_Click"
                                Background="#7C3AED" Style="{StaticResource Btn}"/>
                    </Grid>

                    <!-- Rundown -->
                    <Button Content="🔋  Battery Rundown" Click="Rundown_Click"
                            Background="#059669" Style="{StaticResource Btn}"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </StackPanel>

            <!-- ── Installing panel ── -->
            <StackPanel x:Name="InstallingPanel" Visibility="Collapsed" Margin="20,16,20,20">
                <TextBlock x:Name="InstallStatusText" Text="Downloading…"
                           Style="{StaticResource Label}" HorizontalAlignment="Center"
                           FontSize="12" Margin="0,0,0,10"/>
                <Border Background="#20FFFFFF" CornerRadius="4" Height="6" Margin="0,0,0,4">
                    <Border x:Name="InstallProgressBar" Background="#3B82F6" CornerRadius="4"
                            HorizontalAlignment="Left" Width="0"/>
                </Border>
                <TextBlock x:Name="InstallPctText" Text="0%" Style="{StaticResource Label}"
                           HorizontalAlignment="Center" FontSize="10"/>
            </StackPanel>

            <!-- ── Running panel ── -->
            <StackPanel x:Name="RunningPanel" Visibility="Collapsed" Margin="20,16,20,20">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RunPhaseText" Grid.Column="0" Text="Starting…"
                               Style="{StaticResource Value}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="Dot1" Width="5" Height="5" Fill="#3B82F6" Margin="3,0"/>
                        <Ellipse x:Name="Dot2" Width="5" Height="5" Fill="#3B82F6" Margin="3,0" Opacity="0.5"/>
                        <Ellipse x:Name="Dot3" Width="5" Height="5" Fill="#3B82F6" Margin="3,0" Opacity="0.25"/>
                    </StackPanel>
                </Grid>

                <!-- Trial progress (hidden for single runs) -->
                <TextBlock x:Name="RunTrialText" Text="" Style="{StaticResource Label}"
                           FontSize="9" Margin="0,0,0,8" Visibility="Collapsed"/>

                <Border Background="#12FFFFFF" CornerRadius="6" Height="160" Margin="0,0,0,12">
                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="10"
                                   Foreground="#A0FFFFFF" TextWrapping="Wrap"
                                   Padding="8" LineHeight="16"/>
                    </ScrollViewer>
                </Border>

                <Button Content="Cancel" Click="Cancel_Click"
                        Background="#30FFFFFF" Style="{StaticResource Btn}"
                        HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- ── Single result panel ── -->
            <StackPanel x:Name="ResultPanel" Visibility="Collapsed" Margin="20,16,20,20">
                <TextBlock x:Name="ResultTitle" Text="CPU BENCHMARK RESULTS"
                           Style="{StaticResource Label}"
                           HorizontalAlignment="Center" Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ResultLabelA" Grid.Column="0" Text="Single-Core"
                               Style="{StaticResource Label}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ResultSingle" Grid.Column="1" Text="—"
                               FontSize="22" FontWeight="Bold" FontFamily="Segoe UI" Foreground="White"/>
                </Grid>

                <Border Height="1" Background="#15FFFFFF" Margin="0,6"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ResultLabelB" Grid.Column="0" Text="Multi-Core"
                               Style="{StaticResource Label}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ResultMulti" Grid.Column="1" Text="—"
                               FontSize="22" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#60A5FA"/>
                </Grid>

                <Button Content="Run Again" Click="RunAgain_Click"
                        Background="#30FFFFFF" Style="{StaticResource Btn}"
                        HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- ── Trials result panel ── -->
            <StackPanel x:Name="TrialResultPanel" Visibility="Collapsed" Margin="20,16,20,20">
                <TextBlock x:Name="TrialResultTitle" Text="CPU  ×3 TRIALS"
                           Style="{StaticResource Label}"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <!-- Per-trial scores table: label | T1 | T2 | T3 -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Trial 1" Style="{StaticResource Label}"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Trial 2" Style="{StaticResource Label}"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Trial 3" Style="{StaticResource Label}"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>

                    <!-- Score A row -->
                    <TextBlock x:Name="TrialLabelA" Grid.Row="1" Grid.Column="0"
                               Text="Single" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TrialA1" Grid.Row="1" Grid.Column="1" Text="—"
                               Style="{StaticResource Value}" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TrialA2" Grid.Row="1" Grid.Column="2" Text="—"
                               Style="{StaticResource Value}" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TrialA3" Grid.Row="1" Grid.Column="3" Text="—"
                               Style="{StaticResource Value}" FontSize="12" HorizontalAlignment="Center"/>

                    <!-- Score B row -->
                    <TextBlock x:Name="TrialLabelB" Grid.Row="2" Grid.Column="0"
                               Text="Multi" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TrialB1" Grid.Row="2" Grid.Column="1" Text="—"
                               Style="{StaticResource Value}" FontSize="12" Foreground="#60A5FA"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TrialB2" Grid.Row="2" Grid.Column="2" Text="—"
                               Style="{StaticResource Value}" FontSize="12" Foreground="#60A5FA"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TrialB3" Grid.Row="2" Grid.Column="3" Text="—"
                               Style="{StaticResource Value}" FontSize="12" Foreground="#60A5FA"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </Grid>

                <!-- Average highlight -->
                <Border Background="#0A3B82F6" CornerRadius="8" Padding="12,10"
                        Margin="0,12,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock x:Name="TrialAvgLabelA" Text="AVG SINGLE"
                                       Style="{StaticResource Label}"
                                       HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TrialAvgA" Text="—"
                                       FontFamily="Segoe UI" FontSize="24" FontWeight="Light"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock x:Name="TrialAvgLabelB" Text="AVG MULTI"
                                       Style="{StaticResource Label}"
                                       HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TrialAvgB" Text="—"
                                       FontFamily="Segoe UI" FontSize="24" FontWeight="Light"
                                       Foreground="#60A5FA" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Button Content="Run Again" Click="RunAgain_Click"
                        Background="#30FFFFFF" Style="{StaticResource Btn}"
                        HorizontalAlignment="Center"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
