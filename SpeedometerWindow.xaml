<Window x:Class="SpecIQ.SpeedometerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpecIQ — Speedometer 3.1"
        WindowStyle="None"
        Background="#1A1A2E"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="True"
        MouseLeftButtonDown="TitleBar_MouseDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>


    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="#70FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BigVal" TargetType="TextBlock">
            <Setter Property="FontSize"    Value="22"/>
            <Setter Property="FontWeight"  Value="Light"/>
            <Setter Property="Foreground"  Value="White"/>
        </Style>
        <Style x:Key="SmallVal" TargetType="TextBlock">
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="White"/>
        </Style>
        <!-- Browser selector variant: smaller, ghost background -->
        <Style x:Key="BrowserBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding"  Value="8,6"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
    </Window.Resources>

    <Border Background="#EE1A1A2E" CornerRadius="14" Width="400" x:Name="RootBorder">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>

        <StackPanel>

            <!-- ── Title bar ── -->
            <Grid Margin="20,16,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SPEEDOMETER" FontSize="11" FontWeight="Bold" Foreground="#60A5FA"/>
                    <TextBlock Text=" 3.1"        FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource CloseBtn}" Click="Close_Click"/>
            </Grid>

            <Border Height="1" Background="#15FFFFFF" Margin="0,12,0,0"/>

            <!-- ── CONFIG PANEL ── -->
            <StackPanel x:Name="ConfigPanel" Margin="20,16,20,20">

                <TextBlock Text="Browser-based performance benchmark."
                           Foreground="#70FFFFFF" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,20"/>

                <!-- Browser selection -->
                <TextBlock Text="BROWSER" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="6"/>
                        <ColumnDefinition/><ColumnDefinition Width="6"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnWebView2" Grid.Column="0" Content="WebView2"
                            Style="{StaticResource BrowserBtn}" Click="BrowserBtn_Click" Tag="WebView2"/>
                    <Button x:Name="BtnEdge"     Grid.Column="2" Content="Edge"
                            Style="{StaticResource BrowserBtn}" Click="BrowserBtn_Click" Tag="Edge"/>
                    <Button x:Name="BtnChrome"   Grid.Column="4" Content="Chrome"
                            Style="{StaticResource BrowserBtn}" Click="BrowserBtn_Click" Tag="Chrome"/>
                </Grid>

                <!-- Start buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="6"/>
                        <ColumnDefinition/><ColumnDefinition Width="6"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Single Run"
                            Background="#2563EB" Style="{StaticResource Btn}" Click="StartSingle_Click"/>
                    <Button Grid.Column="2" Content="3 Trials"
                            Background="#2563EB" Style="{StaticResource Btn}" Click="StartTrials_Click"/>
                    <Button Grid.Column="4" Content="Rundown"
                            Background="#2563EB" Style="{StaticResource Btn}" Click="StartRundown_Click"/>
                </Grid>
                <Button Content="⚡  300 Iterations  ·  battery tracked"
                        Background="#D97706" Style="{StaticResource Btn}"
                        Click="Start300Iters_Click" Margin="0,6,0,0"/>

                <!-- Previous result -->
                <Border x:Name="PreviousResultsBorder" Visibility="Collapsed"
                        Background="#0FFFFFFF" CornerRadius="6"
                        Margin="0,12,0,0" Padding="12,10" Cursor="Hand"
                        MouseDown="ViewPrevious_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↩  " Foreground="#60A5FA" FontSize="11"/>
                        <StackPanel>
                            <TextBlock Text="PREVIOUS RESULT" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="PreviousSummaryText"
                                       FontSize="11" Foreground="#CCFFFFFF" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ── RUNNING PANEL ── -->
            <StackPanel x:Name="RunningPanel" Visibility="Collapsed" Margin="20,16,20,20">

                <TextBlock x:Name="RunSubtitleText" FontSize="11" Foreground="#94A3B8"
                           Margin="0,0,0,16"/>

                <!-- Live stats row -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SCORE"   Style="{StaticResource Label}"/>
                        <TextBlock x:Name="RunScore" Text="—" Style="{StaticResource BigVal}"
                                   Foreground="#60A5FA" FontSize="26"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="BATTERY" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="RunBattery" Text="—" Style="{StaticResource SmallVal}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="ELAPSED" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="RunElapsed" Text="0:00:00" Style="{StaticResource SmallVal}"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="RunIterText" Text="Iteration 1"
                           FontSize="11" Foreground="#94A3B8" Margin="0,0,0,8"/>

                <!-- Live mini-chart -->
                <Canvas x:Name="RunChart" Height="80" Margin="0,0,0,8"
                        Background="#08FFFFFF" ClipToBounds="True"/>

                <!-- Log -->
                <ScrollViewer x:Name="RunLogScroll" MaxHeight="100" Margin="0,0,0,12"
                              VerticalScrollBarVisibility="Auto" Background="#08FFFFFF">
                    <TextBlock x:Name="RunLogText" FontSize="10" Foreground="#80FFFFFF"
                               TextWrapping="Wrap" Padding="8"/>
                </ScrollViewer>

                <Button Content="Stop" Background="#DC2626" Style="{StaticResource Btn}"
                        Click="Stop_Click"/>
            </StackPanel>

            <!-- ── RESULTS PANEL ── -->
            <StackPanel x:Name="ResultsPanel" Visibility="Collapsed" Margin="20,16,20,20">

                <TextBlock x:Name="ResTypeText" FontSize="12" FontWeight="SemiBold"
                           Foreground="White" Margin="0,0,0,4"/>

                <!-- Duration + iterations -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DURATION"   Style="{StaticResource Label}"/>
                        <TextBlock x:Name="ResDurationText" Style="{StaticResource SmallVal}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="ITERATIONS" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="ResIterText" Style="{StaticResource SmallVal}"/>
                    </StackPanel>
                </Grid>

                <!-- Chart -->
                <Canvas x:Name="ResChart" Height="140" Margin="0,0,0,16"
                        Background="#08FFFFFF" ClipToBounds="True"
                        Loaded="ResChart_Loaded"/>

                <!-- Trials: individual scores + average -->
                <StackPanel x:Name="TrialsRow" Visibility="Collapsed" Margin="0,0,0,16">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TRIAL 1" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="ResTrial1" Style="{StaticResource SmallVal}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="TRIAL 2" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="ResTrial2" Style="{StaticResource SmallVal}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                            <TextBlock Text="TRIAL 3" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="ResTrial3" Style="{StaticResource SmallVal}"/>
                        </StackPanel>
                    </Grid>
                    <Border Background="#0A60A5FA" CornerRadius="8" Padding="12,10">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="AVERAGE" Style="{StaticResource Label}"
                                       HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock x:Name="ResTrialsAvg" FontSize="36" FontWeight="Light"
                                       Foreground="#60A5FA" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Stats (single / rundown) -->
                <Grid x:Name="StatsRow" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="FIRST" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="ResFirst" Style="{StaticResource SmallVal}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="LAST"  Style="{StaticResource Label}"/>
                        <TextBlock x:Name="ResLast" Style="{StaticResource SmallVal}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="AVG"   Style="{StaticResource Label}"/>
                        <TextBlock x:Name="ResAvg" Style="{StaticResource SmallVal}"/>
                    </StackPanel>
                </Grid>

                <!-- Battery + end time (rundown only) -->
                <Grid x:Name="BatteryRow" Visibility="Collapsed" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="START BAT" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="ResStartBat" Style="{StaticResource SmallVal}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="END BAT"   Style="{StaticResource Label}"/>
                        <TextBlock x:Name="ResEndBat" Style="{StaticResource SmallVal}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="ResBatLabel3" Text="ENDED AT" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="ResEndedAt" Style="{StaticResource SmallVal}"/>
                    </StackPanel>
                </Grid>

                <!-- Action buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="ExportBtn" Content="Export"
                            Background="#1E293B" Style="{StaticResource Btn}" Click="Export_Click"/>
                    <Button Grid.Column="2" Content="Close"
                            Background="#1E293B" Style="{StaticResource Btn}" Click="Close_Click"/>
                </Grid>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
