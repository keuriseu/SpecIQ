<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <AssemblyName>SpecIQ</AssemblyName>
    <RootNamespace>SpecIQ</RootNamespace>
    <Version>1.1.8</Version>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Suppress SDK-generated AssemblyInfo; the WPF temp project generates its own
         copy which conflicts when both are compiled into the same assembly. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3912.50" />
    <PackageReference Include="System.Management" Version="10.0.6" />
  </ItemGroup>

  <!-- Exclude sub-project directory so the WPF temp project's **/*.cs glob
       doesn't pick up ProcyonProbe's generated obj/AssemblyInfo files. -->
  <ItemGroup>
    <Compile Remove="ProcyonProbe\**\*" />
  </ItemGroup>

</Project>
