<Window x:Class="SpecIQ.SuiteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpecIQ — Full Suite"
        WindowStyle="None"
        Background="#1A1A2E"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="True"
        MouseLeftButtonDown="TitleBar_MouseDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#70FFFFFF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#50FFFFFF"/>
        </Style>
    </Window.Resources>

    <Border Background="#EE1A1A2E" CornerRadius="14" Width="500" x:Name="RootBorder">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <StackPanel>

            <!-- ── Title bar ── -->
            <Grid Margin="20,16,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FULL" FontSize="11" FontWeight="Bold" Foreground="#818CF8"
                               FontFamily="Segoe UI"/>
                    <TextBlock Text="  SUITE" FontSize="11" FontWeight="Bold"
                               Foreground="#94A3B8" FontFamily="Segoe UI"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource CloseBtn}" Click="Close_Click"/>
            </Grid>

            <Border Height="1" Background="#15FFFFFF" Margin="0,12,0,0"/>

            <!-- ══════════════════════════════════════════════════════════════
                 PANEL 1 — DISCOVERY
                 ══════════════════════════════════════════════════════════════ -->
            <StackPanel x:Name="DiscoveryPanel" Margin="20,16,20,20">

                <TextBlock Text="Detects installed benchmarks and runs each once."
                           Foreground="#70FFFFFF" FontSize="11" FontFamily="Segoe UI"
                           TextWrapping="Wrap" Margin="0,0,0,14"/>

                <!-- Benchmark list -->
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                    <StackPanel x:Name="DiscoveryList" Margin="0,0,12,0"/>
                </ScrollViewer>

                <!-- Estimated time -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource Lbl}" Text="EST. RUN TIME  "/>
                    <TextBlock x:Name="EstTimeText" FontFamily="Segoe UI" FontSize="11"
                               FontWeight="SemiBold" Foreground="White" Text="—"/>
                </StackPanel>

                <!-- Action buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RunSuiteBtn" Grid.Column="0"
                            Content="Run Suite" Click="RunSuite_Click"
                            Background="#6366F1" Style="{StaticResource Btn}"
                            Padding="0,10" FontSize="13" FontWeight="SemiBold"/>
                    <Button Grid.Column="2" Content="Close" Click="Close_Click"
                            Background="#30FFFFFF" Style="{StaticResource Btn}"
                            Padding="16,10" FontSize="12"/>
                </Grid>
            </StackPanel>

            <!-- ══════════════════════════════════════════════════════════════
                 PANEL 2 — RUNNING
                 ══════════════════════════════════════════════════════════════ -->
            <StackPanel x:Name="RunningPanel" Margin="20,16,20,20" Visibility="Collapsed">

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="RunningItemText"
                               Text="Preparing…"
                               FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="RunElapsed"
                               Text="0:00:00"
                               FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                               Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                </Grid>

                <!-- Item progress list -->
                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                    <StackPanel x:Name="RunningList" Margin="0,0,12,0"/>
                </ScrollViewer>

                <!-- Log -->
                <Border Background="#12FFFFFF" CornerRadius="6" Padding="10,8" Margin="0,0,0,14">
                    <ScrollViewer x:Name="RunLogScroll" MaxHeight="90"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="RunLogText" Text=""
                                   FontFamily="Consolas" FontSize="9.5"
                                   Foreground="#90FFFFFF" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>

                <Button Content="Stop" Click="Stop_Click"
                        Background="#30FFFFFF" Style="{StaticResource Btn}"
                        Padding="0,10" FontSize="12" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- ══════════════════════════════════════════════════════════════
                 PANEL 3 — REPORT
                 ══════════════════════════════════════════════════════════════ -->
            <StackPanel x:Name="ReportPanel" Margin="20,16,20,20" Visibility="Collapsed">

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="ReportMachineText"
                               FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                               Foreground="#80FFFFFF"/>
                    <TextBlock Grid.Column="1" x:Name="ReportDateText"
                               FontFamily="Segoe UI" FontSize="10"
                               Foreground="#50FFFFFF"/>
                </Grid>

                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                    <ItemsControl x:Name="ScoreCards">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Export to Clipboard" Click="Export_Click"
                            Background="#30FFFFFF" Style="{StaticResource Btn}"
                            Padding="0,10" FontSize="12"/>
                    <Button Grid.Column="2" Content="Close" Click="Close_Click"
                            Background="#30FFFFFF" Style="{StaticResource Btn}"
                            Padding="16,10" FontSize="12"/>
                </Grid>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
