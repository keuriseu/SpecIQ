<Window x:Class="SpecIQ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpecIQ"
        WindowStyle="None"
        Background="#1A1A2E"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#80FFFFFF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="IconStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#80FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe MDL2 Assets"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="20"/>
        </Style>
        <Style x:Key="SeparatorStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style x:Key="BarBackground" TargetType="Border">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Height" Value="3"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="#CC1A1A2E"
            CornerRadius="12"
            Padding="16,12"
            MinWidth="200">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <Grid>

        <!-- Battery Focus Mode (hidden by default) -->
        <StackPanel x:Name="BatteryFocusPanel" Visibility="Collapsed"
                    MouseLeftButtonDown="BatteryFocus_Click" Cursor="Hand"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="160">

            <!-- Big percentage -->
            <TextBlock x:Name="BatteryFocusPct" Text="--"
                       FontSize="56" FontWeight="Bold" FontFamily="Segoe UI"
                       Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock x:Name="BatteryFocusStatus" Text="Battery"
                       FontSize="11" FontFamily="Segoe UI"
                       Foreground="#60FFFFFF" HorizontalAlignment="Center"
                       Margin="0,-6,0,10"/>

            <Border Height="1" Background="#20FFFFFF" Margin="0,0,0,10"/>

            <!-- Drain rate + time remaining -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                <TextBlock x:Name="BatteryFocusDrain" Text="-- %/hr"
                           FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI"
                           Foreground="White"/>
                <TextBlock Text=" · " FontSize="13" FontFamily="Segoe UI" Foreground="#40FFFFFF"/>
                <TextBlock x:Name="BatteryFocusTime" Text="--"
                           FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI"
                           Foreground="White"/>
            </StackPanel>

            <!-- Session drain -->
            <TextBlock x:Name="BatteryFocusSession" Text="-- this session"
                       FontSize="10" FontFamily="Segoe UI"
                       Foreground="#60FFFFFF" HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <Border Height="1" Background="#20FFFFFF" Margin="0,0,0,10"/>

            <!-- Capacity row: current / design -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,3">
                <TextBlock x:Name="BatteryFocusCapacity" Text="-- Wh"
                           FontSize="13" FontWeight="SemiBold" FontFamily="Segoe UI"
                           Foreground="White"/>
                <TextBlock Text=" / " FontSize="13" FontFamily="Segoe UI" Foreground="#40FFFFFF"/>
                <TextBlock x:Name="BatteryFocusDesign" Text="-- Wh design"
                           FontSize="13" FontFamily="Segoe UI" Foreground="#80FFFFFF"/>
            </StackPanel>

            <!-- Health -->
            <TextBlock x:Name="BatteryFocusHealth" Text="--% health"
                       FontSize="10" FontFamily="Segoe UI"
                       Foreground="#60FFFFFF" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Geekbench score flash -->
        <StackPanel x:Name="ScorePanel" Visibility="Collapsed"
                    MouseLeftButtonDown="ScorePanel_Click" Cursor="Hand"
                    HorizontalAlignment="Center" MinWidth="180">

            <TextBlock Text="GEEKBENCH 6" FontSize="9" FontFamily="Segoe UI"
                       FontWeight="Bold" Foreground="#50FFFFFF" HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>

            <TextBlock Text="CPU" FontSize="11" FontFamily="Segoe UI"
                       Foreground="#60FFFFFF" HorizontalAlignment="Center"
                       Margin="0,0,0,14"/>

            <Border Height="1" Background="#20FFFFFF" Margin="0,0,0,14"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ScoreLabelA" Grid.Column="0" Text="Single-Core" FontSize="10" FontFamily="Segoe UI"
                           Foreground="#70FFFFFF" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="ScoreSingle" Text="—"
                           FontSize="26" FontWeight="Bold" FontFamily="Segoe UI"
                           Foreground="White" Margin="16,0,0,0"/>
            </Grid>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ScoreLabelB" Grid.Column="0" Text="Multi-Core" FontSize="10" FontFamily="Segoe UI"
                           Foreground="#70FFFFFF" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="ScoreMulti" Text="—"
                           FontSize="26" FontWeight="Bold" FontFamily="Segoe UI"
                           Foreground="#60A5FA" Margin="16,0,0,0"/>
            </Grid>

            <TextBlock x:Name="ScoreDismissHint" Text="tap to dismiss"
                       FontSize="9" FontFamily="Segoe UI"
                       Foreground="#30FFFFFF" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Full overlay -->
        <StackPanel x:Name="ContentPanel">

            <!-- DateTime + launcher toggle -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="TimeText" Text="12:00"
                               FontSize="20" FontWeight="Bold" FontFamily="Segoe UI"
                               Foreground="White" VerticalAlignment="Bottom"/>
                    <TextBlock x:Name="DateText" Text="Mon, Jan 1"
                               FontSize="10" FontFamily="Segoe UI"
                               Foreground="#80FFFFFF" VerticalAlignment="Bottom"
                               Margin="8,0,0,2"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="LauncherToggle"
                           Text="⊞"
                           FontFamily="Segoe UI Symbol" FontSize="15"
                           Foreground="#40FFFFFF"
                           VerticalAlignment="Bottom" Margin="8,0,0,2"
                           Cursor="Hand"
                           MouseLeftButtonDown="LauncherToggle_Click"/>
            </Grid>

            <Border Style="{StaticResource SeparatorStyle}"/>

            <!-- Battery (clickable to toggle focus mode) -->
            <Grid Margin="0,6" x:Name="BatteryRow" MouseLeftButtonDown="BatteryRow_Click" Cursor="Hand"
                  Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE996;" Style="{StaticResource IconStyle}"
                           FontFamily="Segoe MDL2 Assets" x:Name="BatteryIcon"/>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBlock Text="BATTERY" Style="{StaticResource LabelStyle}" FontSize="9"/>
                    <Grid>
                        <Border Style="{StaticResource BarBackground}"/>
                        <Border x:Name="BatteryBar" Background="#4ADE80" CornerRadius="2"
                                Height="3" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                </StackPanel>
                <TextBlock Grid.Column="2" x:Name="BatteryText" Text="--%" Style="{StaticResource ValueStyle}" Margin="10,0,0,0"/>
            </Grid>

            <Border Style="{StaticResource SeparatorStyle}"/>

            <!-- CPU -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE950;" Style="{StaticResource IconStyle}"
                           FontFamily="Segoe MDL2 Assets"/>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBlock Text="CPU" Style="{StaticResource LabelStyle}" FontSize="9"/>
                    <Grid>
                        <Border Style="{StaticResource BarBackground}"/>
                        <Border x:Name="CpuBar" Background="#60A5FA" CornerRadius="2"
                                Height="3" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                </StackPanel>
                <TextBlock Grid.Column="2" x:Name="CpuText" Text="--%" Style="{StaticResource ValueStyle}" Margin="10,0,0,0"/>
            </Grid>

            <Border Style="{StaticResource SeparatorStyle}"/>

            <!-- CPU Temp -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xEC4E;" Style="{StaticResource IconStyle}"
                           FontFamily="Segoe MDL2 Assets"/>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBlock Text="CPU TEMP" Style="{StaticResource LabelStyle}" FontSize="9"/>
                    <Grid>
                        <Border Style="{StaticResource BarBackground}"/>
                        <Border x:Name="TempBar" Background="#4ADE80" CornerRadius="2"
                                Height="3" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                </StackPanel>
                <TextBlock Grid.Column="2" x:Name="TempText" Text="--°C"
                           Style="{StaticResource ValueStyle}" Margin="10,0,0,0"/>
            </Grid>

            <Border Style="{StaticResource SeparatorStyle}"/>

            <!-- RAM -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE964;" Style="{StaticResource IconStyle}"
                           FontFamily="Segoe MDL2 Assets"/>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBlock Text="RAM" Style="{StaticResource LabelStyle}" FontSize="9"/>
                    <Grid>
                        <Border Style="{StaticResource BarBackground}"/>
                        <Border x:Name="RamBar" Background="#C084FC" CornerRadius="2"
                                Height="3" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                </StackPanel>
                <TextBlock Grid.Column="2" x:Name="RamText" Text="-- / -- GB" Style="{StaticResource ValueStyle}" Margin="10,0,0,0"/>
            </Grid>

            <Border Style="{StaticResource SeparatorStyle}"/>

            <!-- GPU -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE7F4;" Style="{StaticResource IconStyle}"
                           FontFamily="Segoe MDL2 Assets"/>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBlock Text="GPU" Style="{StaticResource LabelStyle}" FontSize="9"/>
                    <Grid>
                        <Border Style="{StaticResource BarBackground}"/>
                        <Border x:Name="GpuBar" Background="#FB923C" CornerRadius="2"
                                Height="3" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                </StackPanel>
                <TextBlock Grid.Column="2" x:Name="GpuText" Text="--%" Style="{StaticResource ValueStyle}" Margin="10,0,0,0"/>
            </Grid>

            <Border Style="{StaticResource SeparatorStyle}"/>

            <!-- NPU -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE9D2;" Style="{StaticResource IconStyle}"
                           FontFamily="Segoe MDL2 Assets"/>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBlock Text="NPU" Style="{StaticResource LabelStyle}" FontSize="9"/>
                    <Grid>
                        <Border Style="{StaticResource BarBackground}"/>
                        <Border x:Name="NpuBar" Background="#F472B6" CornerRadius="2"
                                Height="3" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                </StackPanel>
                <TextBlock Grid.Column="2" x:Name="NpuText" Text="--%" Style="{StaticResource ValueStyle}" Margin="10,0,0,0"/>
            </Grid>

            <Border Style="{StaticResource SeparatorStyle}"/>

            <!-- Power Mode -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE83E;" Style="{StaticResource IconStyle}"
                           FontFamily="Segoe MDL2 Assets"/>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBlock Text="POWER MODE" Style="{StaticResource LabelStyle}" FontSize="9" Margin="0,0,0,4"/>
                    <!-- Plugged in -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock x:Name="AcActiveIndicator" Text="● " FontSize="7"
                                   Foreground="#3B82F6" VerticalAlignment="Center"/>
                        <TextBlock Text="⚡ " Style="{StaticResource LabelStyle}" FontSize="9" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AcModeText" Text="—" FontFamily="Segoe UI" FontSize="10"
                                   FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- On battery -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="DcActiveIndicator" Text="● " FontSize="7"
                                   Foreground="#3B82F6" VerticalAlignment="Center"/>
                        <TextBlock Text="🔋 " Style="{StaticResource LabelStyle}" FontSize="9" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DcModeText" Text="—" FontFamily="Segoe UI" FontSize="10"
                                   FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource SeparatorStyle}"/>

            <!-- Energy Saver -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE945;" Style="{StaticResource IconStyle}"
                           FontFamily="Segoe MDL2 Assets"/>
                <TextBlock Grid.Column="1" Text="ENERGY SAVER" Style="{StaticResource LabelStyle}"
                           FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center"/>
                <Border Grid.Column="2" x:Name="EnergySaverBadge"
                        CornerRadius="4" Padding="6,2" Margin="10,0,0,0" Background="Transparent">
                    <TextBlock x:Name="EnergySaverText" Text="OFF"
                               FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold"
                               Foreground="#50FFFFFF"/>
                </Border>
            </Grid>

            <Border Style="{StaticResource SeparatorStyle}"/>

            <!-- Network -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE839;" Style="{StaticResource IconStyle}"
                           FontFamily="Segoe MDL2 Assets" x:Name="NetworkIcon"/>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBlock Text="NETWORK" Style="{StaticResource LabelStyle}" FontSize="9"/>
                    <TextBlock x:Name="NetworkName" Text="--" Style="{StaticResource LabelStyle}"
                               FontSize="10" Foreground="#B0FFFFFF"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="NetworkUpText" Text="-- KB/s" Style="{StaticResource ValueStyle}" FontSize="10" Foreground="#80FFFFFF"/>
                    <TextBlock x:Name="NetworkDownText" Text="-- KB/s" Style="{StaticResource ValueStyle}" FontSize="10"/>
                </StackPanel>
            </Grid>

        </StackPanel>

        <!-- ── Launcher panel ── -->
        <StackPanel x:Name="LauncherPanel" Visibility="Collapsed">

            <!-- DateTime header (mirrors ContentPanel's header) -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="LaunchTimeText" Text="12:00"
                               FontSize="20" FontWeight="Bold" FontFamily="Segoe UI"
                               Foreground="White" VerticalAlignment="Bottom"/>
                    <TextBlock x:Name="LaunchDateText" Text="Mon, Jan 1"
                               FontSize="10" FontFamily="Segoe UI"
                               Foreground="#80FFFFFF" VerticalAlignment="Bottom"
                               Margin="8,0,0,2"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="⊞"
                           FontFamily="Segoe UI Symbol" FontSize="15"
                           Foreground="White"
                           VerticalAlignment="Bottom" Margin="8,0,0,2"
                           Cursor="Hand"
                           MouseLeftButtonDown="LauncherToggle_Click"/>
            </Grid>

            <Border Height="1" Background="#20FFFFFF" Margin="0,0,0,10"/>

            <!-- BENCHMARKS -->
            <TextBlock Text="BENCHMARKS" FontFamily="Segoe UI" FontSize="8"
                       FontWeight="Bold" Foreground="#50FFFFFF" Margin="0,0,0,6"/>
            <Button Content="Full Suite"
                    Click="Launch_Suite" Background="#6366F1"
                    Style="{StaticResource Btn}" Padding="8,6" FontSize="11"
                    HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition Height="5"/><RowDefinition/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Grid.Column="0" Content="Geekbench 6"
                        Click="Launch_GB6" Background="#3B82F6"
                        Style="{StaticResource Btn}" Padding="8,6" FontSize="11"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Geekbench AI"
                        Click="Launch_GBAI" Background="#8B5CF6"
                        Style="{StaticResource Btn}" Padding="8,6" FontSize="11"/>
                <Button Grid.Row="2" Grid.Column="0" Content="Cinebench"
                        Click="Launch_CB" Background="#F59E0B"
                        Style="{StaticResource Btn}" Padding="8,6" FontSize="11"/>
                <Button Grid.Row="2" Grid.Column="2" Content="Speedometer"
                        Click="Launch_SP" Background="#059669"
                        Style="{StaticResource Btn}" Padding="8,6" FontSize="11"/>
            </Grid>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition Height="5"/><RowDefinition/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Grid.Column="0" Content="Procyon AI CV"
                        Click="Launch_Procyon" Background="#0EA5E9"
                        Style="{StaticResource Btn}" Padding="8,6" FontSize="11"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Procyon Office"
                        Click="Launch_ProcyonOffice" Background="#10B981"
                        Style="{StaticResource Btn}" Padding="8,6" FontSize="11"/>
                <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Content="Procyon Essentials"
                        Click="Launch_ProcyonEssentials" Background="#F97316"
                        Style="{StaticResource Btn}" Padding="8,6" FontSize="11"
                        HorizontalAlignment="Stretch"/>
            </Grid>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Blender"
                        Click="Launch_Blender" Background="#C2410C"
                        Style="{StaticResource Btn}" Padding="8,6" FontSize="11"/>
                <Button Grid.Column="2" Content="PugetBench"
                        Click="Launch_PugetBench" Background="#0891B2"
                        Style="{StaticResource Btn}" Padding="8,6" FontSize="11"/>
            </Grid>

            <Border Height="1" Background="#10FFFFFF" Margin="0,10,0,10"/>

            <!-- REPORTS -->
            <TextBlock Text="REPORTS" FontFamily="Segoe UI" FontSize="8"
                       FontWeight="Bold" Foreground="#50FFFFFF" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="5"/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="History"
                        Click="Launch_History" Background="#30FFFFFF"
                        Style="{StaticResource Btn}" Padding="8,6" FontSize="11"/>
                <Button Grid.Column="2" Content="Snapshot"
                        Click="Launch_Snapshot" Background="#30FFFFFF"
                        Style="{StaticResource Btn}" Padding="8,6" FontSize="11"/>
            </Grid>

            <Border Height="1" Background="#10FFFFFF" Margin="0,10,0,10"/>

            <!-- OVERLAY -->
            <TextBlock Text="OVERLAY" FontFamily="Segoe UI" FontSize="8"
                       FontWeight="Bold" Foreground="#50FFFFFF" Margin="0,0,0,6"/>
            <Button Content="Reset Position"
                    Click="Launch_ResetPos" Background="#30FFFFFF"
                    Style="{StaticResource Btn}" Padding="8,6" FontSize="11"
                    HorizontalAlignment="Stretch"/>

            <!-- UI SIZE -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="UI Size" FontFamily="Segoe UI" FontSize="11"
                           Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="−" Click="ScaleDown_Click"
                        Background="#30FFFFFF" Style="{StaticResource Btn}"
                        Padding="8,4" FontSize="13" Width="30"/>
                <TextBlock Grid.Column="2" x:Name="ScaleText" Text="100%"
                           FontFamily="Segoe UI" FontSize="11" Foreground="#CCFFFFFF"
                           VerticalAlignment="Center" TextAlignment="Center" Width="38"/>
                <Button Grid.Column="3" Content="+" Click="ScaleUp_Click"
                        Background="#30FFFFFF" Style="{StaticResource Btn}"
                        Padding="8,4" FontSize="13" Width="30"/>
            </Grid>

        </StackPanel>

        </Grid>
    </Border>
</Window>
