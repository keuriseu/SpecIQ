<Window x:Class="SpecIQ.CinebenchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpecIQ — Cinebench"
        WindowStyle="None"
        Background="#1A1A2E"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="True"
        MouseLeftButtonDown="TitleBar_MouseDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>


    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="Foreground"  Value="#70FFFFFF"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="White"/>
        </Style>
    </Window.Resources>

    <Border Background="#EE1A1A2E" CornerRadius="14" Width="360" x:Name="RootBorder">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>

        <StackPanel>

            <!-- Title bar -->
            <Grid Margin="20,16,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleVersionText" Grid.Column="0" Text="CINEBENCH"
                           FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                           Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource CloseBtn}" Click="Close_Click"/>
            </Grid>

            <Border Height="1" Background="#15FFFFFF" Margin="0,12,0,0"/>

            <!-- ── Ready panel ── -->
            <StackPanel x:Name="ReadyPanel" Margin="20,16,20,20">
                <!-- Previous result (hidden until a result is saved) -->
                <Border x:Name="PreviousResultsBorder" Visibility="Collapsed"
                        Background="#10FFFFFF" CornerRadius="6" Padding="10,8"
                        Margin="0,0,0,12" Cursor="Hand"
                        MouseLeftButtonDown="ViewPrevious_Click">
                    <StackPanel>
                        <TextBlock Text="PREVIOUS RESULT" FontFamily="Segoe UI" FontSize="9"
                                   FontWeight="SemiBold" Foreground="#70FFFFFF" Margin="0,0,0,4"/>
                        <TextBlock x:Name="PreviousSummaryText" FontFamily="Segoe UI"
                                   FontSize="11" Foreground="#AAFFFFFF"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="StatusText" Text="—" Style="{StaticResource Label}"
                           HorizontalAlignment="Center" FontSize="11" Margin="0,0,0,16"/>

                <!-- Not found row -->
                <StackPanel x:Name="NotFoundRow" Visibility="Collapsed">
                    <TextBlock Text="Cinebench.exe not found." Style="{StaticResource Label}"
                               HorizontalAlignment="Center" Margin="0,0,0,10" FontSize="11"/>
                    <Button Content="Browse…" Click="Browse_Click"
                            Background="#30FFFFFF" Style="{StaticResource Btn}"
                            HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Run row -->
                <StackPanel x:Name="RunRow" Visibility="Collapsed">
                    <!-- Single | Multi -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Single-Core" Click="RunSingleCore_Click"
                                Background="#F59E0B" Style="{StaticResource Btn}"/>
                        <Button Grid.Column="2" Content="Multi-Core" Click="RunMultiCore_Click"
                                Background="#D97706" Style="{StaticResource Btn}"/>
                    </Grid>
                    <!-- ×3 Runs -->
                    <Button Content="×3 Runs  (3 min cooldown)" Click="RunThree_Click"
                            Background="#B45309" Style="{StaticResource Btn}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                    <Button Content="Browse…" Click="Browse_Click"
                            Background="#20FFFFFF" Style="{StaticResource Btn}"
                            HorizontalAlignment="Center" FontSize="11" Padding="14,6"/>
                </StackPanel>
            </StackPanel>

            <!-- ── Running panel ── -->
            <StackPanel x:Name="RunningPanel" Visibility="Collapsed" Margin="20,16,20,20">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RunPhaseText" Grid.Column="0" Text="Starting…"
                               Style="{StaticResource Value}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="Dot1" Width="5" Height="5" Fill="#F59E0B" Margin="3,0"/>
                        <Ellipse x:Name="Dot2" Width="5" Height="5" Fill="#F59E0B" Margin="3,0" Opacity="0.5"/>
                        <Ellipse x:Name="Dot3" Width="5" Height="5" Fill="#F59E0B" Margin="3,0" Opacity="0.25"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="RunTrialText" Text="" Style="{StaticResource Label}"
                           FontSize="9" Margin="0,0,0,8" Visibility="Collapsed"/>

                <!-- Live trial scores (shown during multi-trial runs) -->
                <Grid x:Name="LiveScoresGrid" Visibility="Collapsed" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Headers -->
                    <TextBlock Grid.Column="1" Text="T1" Style="{StaticResource Label}" FontSize="9" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="T2" Style="{StaticResource Label}" FontSize="9" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="T3" Style="{StaticResource Label}" FontSize="9" HorizontalAlignment="Center"/>
                    <!-- Single -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Single" Style="{StaticResource Label}" FontSize="9" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LiveS1" Grid.Row="1" Grid.Column="1" Text="—" Style="{StaticResource Value}" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LiveS2" Grid.Row="1" Grid.Column="2" Text="—" Style="{StaticResource Value}" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LiveS3" Grid.Row="1" Grid.Column="3" Text="—" Style="{StaticResource Value}" FontSize="11" HorizontalAlignment="Center"/>
                    <!-- Multi -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Multi" Style="{StaticResource Label}" FontSize="9" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LiveM1" Grid.Row="2" Grid.Column="1" Text="—" Style="{StaticResource Value}" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LiveM2" Grid.Row="2" Grid.Column="2" Text="—" Style="{StaticResource Value}" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LiveM3" Grid.Row="2" Grid.Column="3" Text="—" Style="{StaticResource Value}" FontSize="11" HorizontalAlignment="Center"/>
                </Grid>

                <TextBlock Text="Cinebench runs in its own window." Style="{StaticResource Label}"
                           FontSize="10" Margin="0,0,0,12" Foreground="#50FFFFFF"/>

                <StackPanel x:Name="CancelArea" HorizontalAlignment="Center">
                    <Button x:Name="CancelBtn" Content="Cancel" Click="Cancel_Click"
                            Background="#30FFFFFF" Style="{StaticResource Btn}"/>
                    <StackPanel x:Name="CancelConfirmPanel" Visibility="Collapsed"
                                Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Cancel run?" Foreground="#80FFFFFF" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Yes" Click="CancelConfirm_Click"
                                Background="#DC2626" Style="{StaticResource Btn}"
                                Padding="14,7" Margin="0,0,6,0"/>
                        <Button Content="Keep running" Click="CancelDismiss_Click"
                                Background="#30FFFFFF" Style="{StaticResource Btn}"
                                Padding="14,7"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- ── Single result panel ── -->
            <StackPanel x:Name="ResultPanel" Visibility="Collapsed" Margin="20,16,20,20">
                <TextBlock Text="CINEBENCH 2026 RESULTS" Style="{StaticResource Label}"
                           HorizontalAlignment="Center" Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Single-Core"
                               Style="{StaticResource Label}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ResultSingle" Grid.Column="1" Text="—"
                               FontSize="22" FontWeight="Bold" FontFamily="Segoe UI" Foreground="White"/>
                </Grid>

                <Border Height="1" Background="#15FFFFFF" Margin="0,6"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Multi-Core"
                               Style="{StaticResource Label}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ResultMulti" Grid.Column="1" Text="—"
                               FontSize="22" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#FCD34D"/>
                </Grid>

                <Button Content="Run Again" Click="RunAgain_Click"
                        Background="#30FFFFFF" Style="{StaticResource Btn}"
                        HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- ── Trials result panel ── -->
            <StackPanel x:Name="TrialResultPanel" Visibility="Collapsed" Margin="20,16,20,20">
                <TextBlock Text="CINEBENCH 2026  ×3 TRIALS" Style="{StaticResource Label}"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Trial 1" Style="{StaticResource Label}"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Trial 2" Style="{StaticResource Label}"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Trial 3" Style="{StaticResource Label}"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Single"
                               Style="{StaticResource Label}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TrialS1" Grid.Row="1" Grid.Column="1" Text="—"
                               Style="{StaticResource Value}" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TrialS2" Grid.Row="1" Grid.Column="2" Text="—"
                               Style="{StaticResource Value}" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TrialS3" Grid.Row="1" Grid.Column="3" Text="—"
                               Style="{StaticResource Value}" FontSize="12" HorizontalAlignment="Center"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Multi"
                               Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TrialM1" Grid.Row="2" Grid.Column="1" Text="—"
                               Style="{StaticResource Value}" FontSize="12" Foreground="#FCD34D"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TrialM2" Grid.Row="2" Grid.Column="2" Text="—"
                               Style="{StaticResource Value}" FontSize="12" Foreground="#FCD34D"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TrialM3" Grid.Row="2" Grid.Column="3" Text="—"
                               Style="{StaticResource Value}" FontSize="12" Foreground="#FCD34D"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </Grid>

                <Border Background="#0AF59E0B" CornerRadius="8" Padding="12,10" Margin="0,12,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="AVG SINGLE" Style="{StaticResource Label}"
                                       HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TrialAvgS" Text="—"
                                       FontFamily="Segoe UI" FontSize="24" FontWeight="Light"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="AVG MULTI" Style="{StaticResource Label}"
                                       HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock x:Name="TrialAvgM" Text="—"
                                       FontFamily="Segoe UI" FontSize="24" FontWeight="Light"
                                       Foreground="#FCD34D" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Button Content="Run Again" Click="RunAgain_Click"
                        Background="#30FFFFFF" Style="{StaticResource Btn}"
                        HorizontalAlignment="Center"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
