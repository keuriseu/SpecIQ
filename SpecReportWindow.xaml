<Window x:Class="SpecIQ.SpecReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpecIQ — System Snapshot"
        WindowStyle="None"
        Background="#1A1A2E"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Width="460"
        SizeToContent="Height"
        Topmost="True"
        ShowInTaskbar="True"
        MouseLeftButtonDown="TitleBar_MouseDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>


    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Foreground" Value="#70FFFFFF"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Border Background="#EE1A1A2E" CornerRadius="14" Width="460">

        <StackPanel>

            <!-- Title bar -->
            <Grid Margin="20,16,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="SYSTEM SNAPSHOT"
                           FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                           Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource CloseBtn}" Click="Close_Click"/>
            </Grid>

            <Border Height="1" Background="#15FFFFFF" Margin="0,12,0,0"/>

            <!-- ── Loading panel ── -->
            <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center"
                        Margin="20,24,20,28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Gathering system info…"
                               Style="{StaticResource Value}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Ellipse x:Name="Dot1" Width="5" Height="5" Fill="#3B82F6" Margin="3,0"/>
                        <Ellipse x:Name="Dot2" Width="5" Height="5" Fill="#3B82F6" Margin="3,0" Opacity="0.5"/>
                        <Ellipse x:Name="Dot3" Width="5" Height="5" Fill="#3B82F6" Margin="3,0" Opacity="0.25"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ── Report panel ── -->
            <StackPanel x:Name="ReportPanel" Visibility="Collapsed" Margin="16,16,16,16">

                <!-- Monospace preview -->
                <Border Background="#0CFFFFFF" CornerRadius="8" Padding="12,10"
                        Margin="0,0,0,14">
                    <ScrollViewer MaxHeight="340"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ReportText"
                                   FontFamily="Consolas" FontSize="10.5"
                                   Foreground="#E0FFFFFF"
                                   LineHeight="17"
                                   TextWrapping="NoWrap"/>
                    </ScrollViewer>
                </Border>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="CopyBtn"
                            Content="Copy to Clipboard"
                            Click="Copy_Click"
                            Background="#3B82F6"
                            Style="{StaticResource Btn}"
                            Margin="0,0,8,0"/>
                    <Button Content="Refresh"
                            Click="Refresh_Click"
                            Background="#30FFFFFF"
                            Style="{StaticResource Btn}"/>
                </StackPanel>

            </StackPanel>

        </StackPanel>
    </Border>
</Window>
