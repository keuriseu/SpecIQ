<Window x:Class="SpecIQ.PugetBenchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpecIQ — PugetBench"
        WindowStyle="None"
        Background="#1A1A2E"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="True"
        MouseLeftButtonDown="TitleBar_MouseDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="10"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Foreground"        Value="#70FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily"        Value="Segoe UI"/>
        </Style>
        <Style x:Key="BigVal" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="22"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="SmallVal" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Border Background="#EE1A1A2E" CornerRadius="14" Width="480">
        <StackPanel>

            <!-- ── Title bar ── -->
            <Grid Margin="20,16,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PUGETBENCH" FontSize="11" FontWeight="Bold"
                               Foreground="#0891B2" FontFamily="Segoe UI"/>
                    <TextBlock Text="  FOR PHOTOSHOP" FontSize="11" FontWeight="Bold"
                               Foreground="#94A3B8" FontFamily="Segoe UI"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource CloseBtn}" Click="Close_Click"/>
            </Grid>

            <Border Height="1" Background="#15FFFFFF" Margin="0,12,0,0"/>

            <!-- ══════════════════════════════════════════════════════════════
                 CONFIG PANEL
                 ══════════════════════════════════════════════════════════════ -->
            <StackPanel x:Name="ConfigPanel" Margin="20,16,20,20">

                <TextBlock Text="Runs the Photoshop benchmark via PugetBench for Creators. Launch the app and click Run Benchmark when prompted."
                           Foreground="#70FFFFFF" FontSize="11" FontFamily="Segoe UI"
                           TextWrapping="Wrap" Margin="0,0,0,14"/>

                <!-- Status checklist -->
                <Border Background="#0FFFFFFF" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="PREREQUISITES" Style="{StaticResource Lbl}" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PugetBench for Creators"
                                       FontSize="11" FontFamily="Segoe UI" Foreground="#CCFFFFFF"/>
                            <TextBlock Grid.Column="1" x:Name="LauncherStatus"
                                       FontSize="11" FontFamily="Segoe UI" Foreground="#60FFFFFF"/>
                        </Grid>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Adobe Photoshop"
                                       FontSize="11" FontFamily="Segoe UI" Foreground="#CCFFFFFF"/>
                            <TextBlock Grid.Column="1" x:Name="PhotoshopStatus"
                                       FontSize="11" FontFamily="Segoe UI" Foreground="#60FFFFFF"/>
                        </Grid>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Photoshop assets"
                                       FontSize="11" FontFamily="Segoe UI" Foreground="#CCFFFFFF"/>
                            <TextBlock Grid.Column="1" x:Name="AssetsStatus"
                                       FontSize="11" FontFamily="Segoe UI" Foreground="#60FFFFFF"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Benchmark definition"
                                       FontSize="11" FontFamily="Segoe UI" Foreground="#CCFFFFFF"/>
                            <TextBlock Grid.Column="1" x:Name="BenchmarkStatus"
                                       FontSize="11" FontFamily="Segoe UI" Foreground="#60FFFFFF"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Previous result -->
                <Border x:Name="PreviousResultsBorder" Visibility="Collapsed"
                        Background="#0FFFFFFF" CornerRadius="6" Margin="0,0,0,10" Padding="12,10"
                        Cursor="Hand" MouseDown="ViewPrevious_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="↩  " Foreground="#0891B2" FontSize="11"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="PREVIOUS RESULT" Style="{StaticResource Lbl}"/>
                            <TextBlock x:Name="PreviousSummaryText"
                                       FontSize="11" FontFamily="Segoe UI"
                                       Foreground="#CCFFFFFF" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="PreviousScoreText"
                                   FontSize="22" FontWeight="Light" FontFamily="Segoe UI"
                                   Foreground="#0891B2" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Action buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="LaunchBtn" Grid.Column="0" Content="Launch &amp; Run"
                            Background="#0891B2" Style="{StaticResource Btn}"
                            Padding="8,6" Click="LaunchRun_Click"/>
                    <Button Grid.Column="2" Content="Close"
                            Background="#1E293B" Style="{StaticResource Btn}"
                            Padding="20,6" Click="Close_Click"/>
                </Grid>

            </StackPanel>

            <!-- ══════════════════════════════════════════════════════════════
                 RUNNING PANEL
                 ══════════════════════════════════════════════════════════════ -->
            <StackPanel x:Name="RunningPanel" Visibility="Collapsed" Margin="20,16,20,20">

                <!-- Action banner (hidden once first result arrives) -->
                <Border x:Name="ActionBanner" Background="#0F0891B2"
                        BorderBrush="#400891B2" BorderThickness="1"
                        CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x26A0;  " Foreground="#0891B2" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="Switch to PugetBench for Creators and click Run Benchmark for Photoshop"
                                   FontSize="11" FontFamily="Segoe UI" Foreground="#AAFFFFFF"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Live stats row -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="COMPOSITE" Style="{StaticResource Lbl}"/>
                        <TextBlock x:Name="RunScore" Text="—" Style="{StaticResource BigVal}"
                                   Foreground="#0891B2" FontSize="28"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="TESTS" Style="{StaticResource Lbl}"/>
                        <TextBlock x:Name="RunProgress" Text="0 / 21" Style="{StaticResource SmallVal}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="ELAPSED" Style="{StaticResource Lbl}"/>
                        <TextBlock x:Name="RunElapsed" Text="0:00:00" Style="{StaticResource SmallVal}"/>
                    </StackPanel>
                </Grid>

                <!-- Sub-scores -->
                <Border Background="#0AFFFFFF" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="1" Background="#15FFFFFF"/>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="GENERAL" Style="{StaticResource Lbl}"
                                       HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock x:Name="RunGeneralScore" Text="—" Style="{StaticResource SmallVal}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="FILTER" Style="{StaticResource Lbl}"
                                       HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock x:Name="RunFilterScore" Text="—" Style="{StaticResource SmallVal}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Test log -->
                <ScrollViewer x:Name="RunLogScroll" MaxHeight="160" Margin="0,0,0,12"
                              VerticalScrollBarVisibility="Auto" Background="#08FFFFFF">
                    <TextBlock x:Name="RunLogText" FontSize="10" FontFamily="Consolas"
                               Foreground="#80FFFFFF" TextWrapping="NoWrap" Padding="8"/>
                </ScrollViewer>

                <Button Content="Stop" Background="#DC2626" Style="{StaticResource Btn}"
                        Click="Stop_Click"/>

            </StackPanel>

            <!-- ══════════════════════════════════════════════════════════════
                 RESULTS PANEL
                 ══════════════════════════════════════════════════════════════ -->
            <StackPanel x:Name="ResultsPanel" Visibility="Collapsed" Margin="20,16,20,20">

                <TextBlock x:Name="ResHeaderText" FontSize="12" FontWeight="SemiBold"
                           FontFamily="Segoe UI" Foreground="White" Margin="0,0,0,12"/>

                <!-- Score card -->
                <Border Background="#0A0891B2" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="COMPOSITE SCORE" Style="{StaticResource Lbl}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="ResScore" Text="—" FontSize="44" FontWeight="Light"
                                       FontFamily="Segoe UI" Foreground="#0891B2"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="GENERAL" Style="{StaticResource Lbl}"
                                       HorizontalAlignment="Right" Margin="0,0,0,2"/>
                            <TextBlock x:Name="ResGeneral" Text="—" Style="{StaticResource SmallVal}"
                                       HorizontalAlignment="Right" Margin="0,0,0,8"/>
                            <TextBlock Text="FILTER" Style="{StaticResource Lbl}"
                                       HorizontalAlignment="Right" Margin="0,0,0,2"/>
                            <TextBlock x:Name="ResFilter" Text="—" Style="{StaticResource SmallVal}"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Test breakdown table -->
                <Border Background="#0AFFFFFF" CornerRadius="6" Margin="0,0,0,12">
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ResTestList" Margin="12,8"/>
                    </ScrollViewer>
                </Border>

                <!-- Action buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="8"/>
                        <ColumnDefinition/><ColumnDefinition Width="8"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Run Again"
                            Background="#0891B2" Style="{StaticResource Btn}" Click="RunAgain_Click"/>
                    <Button Grid.Column="2" Content="Export"
                            Background="#1E293B" Style="{StaticResource Btn}" Click="Export_Click"/>
                    <Button Grid.Column="4" Content="Close"
                            Background="#1E293B" Style="{StaticResource Btn}" Click="Close_Click"/>
                </Grid>

            </StackPanel>

        </StackPanel>
    </Border>
</Window>
